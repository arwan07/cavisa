# Konfigurasi contoh. Salin ke `.env` atau set sebagai environment variable.
# Format: KEY=NILAI (tanpa tanda kutip, kecuali daftar yang memakai koma).

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# "*" atau daftar origin dipisah koma, misal: http://localhost:8001,https://app.domain.co.id
CORS_ORIGINS=*

# --- Model ---
# Lokasi folder model .pkl (mlp_model.pkl, svm_model.pkl, rf_model.pkl, knn_model.pkl, nb_model.pkl)
MODEL_DIR=./app/models
MLP_PICKLE_NAME=mlp_model.pkl
# Model learner aktif: mlp | svm | rf | knn | nb
ACTIVE_MODEL=mlp
# true = inisialisasi model baseline (acak) bila folder model kosong
AUTO_TRAIN_BASELINE=true

# --- Batas unggah ---
MAX_UPLOAD_MB=10
MAX_BATCH_FILES=20
# Batas piksel per citra (guard decompression bomb)
MAX_PIXELS=40000000

# Catatan arsitektur (tetap, tidak perlu diubah):
#   Embedding = SqueezeNet Orange (ndf), input 227x227, RGB->BGR, mean Caffe,
#   lapisan pra-softmax flatten10 -> vektor 1000 dimensi. Wajib sama dengan
#   cara ekstraksi fitur di Orange (SMIDS.ows) agar klasifikasi akurat.
